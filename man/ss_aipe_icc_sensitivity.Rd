ss_aipe_icc_sensitivity(
  true_icc      = 0.70,
  supposed_icc  = 0.70,
  n_raters      = 3,
  width         = 0.40,
  conf_level    = 0.95,
  G             = 25,
  print_iter    = FALSE
)

# Misspecified case: the planner used .70 but the truth is .50.
# The realized interval widths will tend to be wider than the target.
set.seed(113)
ss_aipe_icc_sensitivity(
  true_icc      = 0.50,
  supposed_icc  = 0.70,
  n_raters      = 3,
  width         = 0.40,
  conf_level    = 0.95,
  G             = 25,
  print_iter    = FALSE
)

# Fixed-n mode: skip the planner and evaluate at a chosen sample size.
set.seed(113)
ss_aipe_icc_sensitivity(
  true_icc    = 0.50,
  specified_N = 40,
  n_raters    = 3,
  width       = 0.40,
  G           = 25,
  print_iter  = FALSE
)

}
