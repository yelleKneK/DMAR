equivalence_c(means = c(70.40, 55.61, 51.91, 65.66, 65.12),
       s_anova = 15.67,
       c_weights = c(-1, 0, 0, 0, 1),
       n_per_group = c(113, 74, 76, 80, 61),
       contrast_upper = 5)

